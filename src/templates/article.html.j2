<script>
(function(){
'use strict';
var D = JSON.parse(document.getElementById('dados').textContent);
var R = D.registros, NS = 'http://www.w3.org/2000/svg';
function fmt(x, c){ return x.toLocaleString('pt-BR', {minimumFractionDigits:c||0, maximumFractionDigits:c||0}); }
function sgn(x, c){ return (x>0?'+':'') + fmt(x, c).replace('-', '−'); }
function $(id){ return document.getElementById(id); }
function el(tag, attrs, parent){
  var e = document.createElementNS(NS, tag);
  for (var k in attrs) if (attrs.hasOwnProperty(k)) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
}
function niceStep(range, n){
  var raw = range / n, p = Math.pow(10, Math.floor(Math.log10(raw))), f = raw / p;
  return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * p;
}
function ticks(lo, hi, n){
  var s = niceStep(hi - lo, n), out = [], t = Math.ceil(lo / s - 1e-9) * s;
  for (; t <= hi + 1e-9; t += s) out.push(Math.round(t * 1e6) / 1e6);
  return {vals: out, step: s};
}
function median(a){ var b = a.slice().sort(function(x,y){return x-y;}), n = b.length; return n % 2 ? b[(n-1)/2] : (b[n/2-1] + b[n/2]) / 2; }
function theilSen(xs, ys){
  var sl = [];
  for (var i = 0; i < xs.length; i++) for (var j = i + 1; j < xs.length; j++) sl.push((ys[j]-ys[i]) / (xs[j]-xs[i]));
  var b = median(sl); return {b: b, a: median(ys) - b * median(xs)};
}
function Tip(wrap){
  var t = document.createElement('div'); t.className = 'tip'; t.setAttribute('role', 'status'); wrap.appendChild(t);
  return {
    show: function(html, x, y){
      t.innerHTML = html; t.classList.add('on');
      var w = wrap.clientWidth, tw = t.offsetWidth, th = t.offsetHeight;
      var left = Math.min(Math.max(x + 12, 4), w - tw - 4);
      var top = y - th - 12; if (top < 0) top = y + 16;
      t.style.left = left + 'px'; t.style.top = top + 'px';
    },
    hide: function(){ t.classList.remove('on'); }
  };
}
function setup(wrap, draw){
  var last = 0;
  function go(){ var w = Math.max(wrap.clientWidth, 300); if (w !== last){ last = w; } draw(w); }
  if (window.ResizeObserver){ new ResizeObserver(function(){ if (Math.abs(wrap.clientWidth - last) > 1) go(); }).observe(wrap); }
  else window.addEventListener('resize', go);
  go();
  return go;
}

/* ---------------- Figura 2: explorador ---------------- */
(function(){
  var wrap = $('chartA'); if (!wrap) return;
  var S = {metric:'vitimas', reg:true, trend:false, evt:true, from:2003, to:2022};
  var M = {vitimas:{lab:'Vítimas (nº)', dec:0, nome:'Vítimas'}, taxa:{lab:'Taxa por 100 mil hab.', dec:2, nome:'Taxa por 100 mil hab.'}, media_mensal:{lab:'Média mensal (vítimas/mês)', dec:1, nome:'Média mensal'}};
  var tip = Tip(wrap), svg;
  function draw(W){
    if (svg) wrap.removeChild(svg);
    var narrow = W < 520, H = Math.round(Math.max(270, Math.min(W * 0.56, 420)));
    var m = {l: narrow ? 40 : 52, r: 14, t: 14, b: 44};
    var key = S.metric, mm = M[key];
    var data = R.filter(function(r){ return r.ano >= S.from && r.ano <= S.to; });
    var vals = data.map(function(r){ return r[key]; });
    var ymax = Math.max.apply(null, vals) * 1.12, yt = ticks(0, ymax, narrow ? 4 : 5);
    ymax = yt.vals[yt.vals.length - 1] >= ymax ? yt.vals[yt.vals.length - 1] : yt.vals[yt.vals.length - 1] + yt.step;
    var x0 = S.from - 0.5, x1 = S.to + 0.5;
    function X(v){ return m.l + (v - x0) / (x1 - x0) * (W - m.l - m.r); }
    function Y(v){ return H - m.b - v / ymax * (H - m.t - m.b); }
    svg = el('svg', {viewBox:'0 0 ' + W + ' ' + H, width:W, height:H, role:'img', 'aria-label':'Série anual de ' + mm.nome.toLowerCase() + ', ' + S.from + ' a ' + S.to});
    wrap.insertBefore(svg, wrap.firstChild);
    var t, i;
    for (t = 0; t <= ymax + 1e-9; t += yt.step){
      el('line', {x1:m.l, x2:W - m.r, y1:Y(t), y2:Y(t), 'class': t === 0 ? 'base' : 'grid'}, svg);
      el('text', {x:m.l - 8, y:Y(t) + 4, 'text-anchor':'end'}, svg).textContent = fmt(t, yt.step < 1 ? 1 : 0);
    }
    var step = Math.max(1, Math.ceil(36 / ((W - m.l - m.r) / (x1 - x0))));
    data.forEach(function(r){ if ((r.ano - S.from) % step === 0 || r.ano === S.to && step === 1){
      el('text', {x:X(r.ano), y:H - m.b + 18, 'text-anchor':'middle'}, svg).textContent = r.ano; }});
    el('text', {x:m.l, y:H - 4, 'class':'axis-title'}, svg).textContent = mm.lab + ' · 1º quadrimestre (jan–abr)';
    // quebra + regimes
    if (S.reg){
      var q = D.quebra - 0.5;
      if (q > x0 && q < x1){
        el('line', {x1:X(q), x2:X(q), y1:m.t, y2:H - m.b, 'class':'brk'}, svg);
        el('text', {x:X(q) + 4, y:m.t + 10, 'class':'halo'}, svg).textContent = 'quebra ótima: ' + D.quebra;
      }
      D.regimes.forEach(function(g){
        var d = data.filter(function(r){ return r.ano >= g.a && r.ano <= g.b; });
        if (!d.length) return;
        var mu = d.reduce(function(s, r){ return s + r[key]; }, 0) / d.length;
        var xa = X(d[0].ano - 0.4), xb = X(d[d.length - 1].ano + 0.4);
        el('line', {x1:xa, x2:xb, y1:Y(mu), y2:Y(mu), 'class':'reg'}, svg);
        if (xb - xa > 46) el('text', {x:xa + 3, y:Y(mu) - 6, 'class':'halo'}, svg).textContent = 'média ' + fmt(mu, mm.dec);
      });
    }
    // tendência
    if (S.trend && data.length >= 3){
      var ts = theilSen(data.map(function(r){return r.ano;}), vals);
      var ya = ts.a + ts.b * x0, yb = ts.a + ts.b * x1;
      el('line', {x1:X(x0), y1:Y(Math.max(ya, 0)), x2:X(x1), y2:Y(Math.max(yb, 0)), 'class':'trend'}, svg);
      el('text', {x:W - m.r - 4, y:Y(Math.max(yb, 0)) - 8, 'text-anchor':'end', 'class':'halo'}, svg).textContent = 'Theil–Sen: ' + sgn(ts.b, mm.dec === 0 ? 1 : mm.dec + 1) + '/ano';
    }
    // linha e pontos
    var d = data.map(function(r, k){ return (k ? 'L' : 'M') + X(r.ano).toFixed(1) + ',' + Y(r[key]).toFixed(1); }).join('');
    el('path', {d:d, 'class':'ln s1'}, svg);
    var cross = el('line', {y1:m.t, y2:H - m.b, 'class':'cross', visibility:'hidden'}, svg);
    var pts = data.map(function(r){
      var c = el('circle', {cx:X(r.ano), cy:Y(r[key]), r:4.5, 'class':'pt s1', tabindex:0, role:'img',
        'aria-label': r.ano + ': ' + fmt(r[key], mm.dec) + ' (' + mm.nome + ')'}, svg);
      return c;
    });
    function showAt(i){
      var r = data[i], cx = X(r.ano);
      cross.setAttribute('x1', cx); cross.setAttribute('x2', cx); cross.setAttribute('visibility', 'visible');
      pts.forEach(function(p, k){ p.setAttribute('r', k === i ? 6.5 : 4.5); });
      var v = r.var_pct == null ? '' : '<br><span class="dim">vs ano anterior:</span> ' + sgn(r.var_pct, 1) + '%';
      tip.show('<b>' + r.ano + '</b><br>' + mm.nome + ': <b>' + fmt(r[key], mm.dec) + '</b>' + v, cx, Y(r[key]));
    }
    function hideAll(){ cross.setAttribute('visibility', 'hidden'); pts.forEach(function(p){ p.setAttribute('r', 4.5); }); tip.hide(); }
    var bw = (W - m.l - m.r) / (x1 - x0);
    data.forEach(function(r, i){
      var h = el('rect', {x:X(r.ano) - bw / 2, y:m.t, width:bw, height:H - m.t - m.b, 'class':'hit'}, svg);
      h.addEventListener('pointerenter', function(){ showAt(i); });
      h.addEventListener('pointermove', function(){ showAt(i); });
      pts[i].addEventListener('focus', function(){ showAt(i); });
      pts[i].addEventListener('blur', hideAll);
    });
    svg.addEventListener('pointerleave', hideAll);
    // marcos
    if (S.evt) D.eventos.forEach(function(ev){
      if (ev.x < x0 || ev.x > x1) return;
      var ex = X(ev.x), ey = H - m.b;
      var g = el('path', {d:'M' + (ex - 6) + ',' + (ey + 0) + ' L' + (ex + 6) + ',' + ey + ' L' + ex + ',' + (ey - 11) + 'Z', 'class':'evt', tabindex:0, role:'img', 'aria-label':'Marco: ' + ev.rotulo + '. ' + ev.texto}, svg);
      function on(){ tip.show('<b>' + ev.rotulo + '</b><br><span class="dim">' + ev.texto + '</span>', ex, ey - 12); }
      g.addEventListener('pointerenter', on); g.addEventListener('focus', on);
      g.addEventListener('pointerleave', hideAll); g.addEventListener('blur', hideAll);
    });
  }
  var go = setup(wrap, draw);
  function sync(){ go(); }
  Array.prototype.forEach.call(document.getElementsByName('metricA'), function(r){ r.addEventListener('change', function(){ S.metric = r.value; sync(); }); });
  $('aReg').addEventListener('change', function(e){ S.reg = e.target.checked; sync(); });
  $('aTrend').addEventListener('change', function(e){ S.trend = e.target.checked; sync(); });
  $('aEvt').addEventListener('change', function(e){ S.evt = e.target.checked; sync(); });
  function range(){
    var f = $('aFrom'), t = $('aTo'), a = +f.value, b = +t.value;
    if (b - a < 2){ if (document.activeElement === f) { a = b - 2; f.value = a; } else { b = a + 2; t.value = b; } }
    S.from = a; S.to = b; $('aFromOut').textContent = a; $('aToOut').textContent = b;
    $('aMsg').textContent = 'Mostrando ' + a + '–' + b + ' (' + (b - a + 1) + ' anos).';
    sync();
  }
  $('aFrom').addEventListener('input', range); $('aTo').addEventListener('input', range);
})();

/* ---------------- Figura 7: índices ---------------- */
(function(){
  var wrap = $('chartB'); if (!wrap) return;
  var SER = [
    {k:'idx_vitimas', nome:'Vítimas', cls:'s1', on:true},
    {k:'idx_taxa', nome:'Taxa por 100 mil hab.', cls:'s2', on:true},
    {k:'idx_pop', nome:'População', cls:'s3', on:true}
  ];
  var tip = Tip(wrap), svg, lg = $('legendB');
  var colors = {s1:'var(--c1)', s2:'var(--c2)', s3:'var(--c3)'};
  SER.forEach(function(s){
    var li = document.createElement('li'), b = document.createElement('button');
    b.type = 'button'; b.setAttribute('aria-pressed', 'true');
    b.innerHTML = '<i style="background:' + colors[s.cls] + '"></i>' + s.nome;
    b.addEventListener('click', function(){ s.on = !s.on; b.setAttribute('aria-pressed', String(s.on)); go(); });
    li.appendChild(b); lg.appendChild(li);
  });
  function draw(W){
    if (svg) wrap.removeChild(svg);
    var narrow = W < 560, H = Math.round(Math.max(260, Math.min(W * 0.55, 400)));
    var m = {l: narrow ? 38 : 48, r: narrow ? 14 : 122, t: 14, b: 40};
    var vis = SER.filter(function(s){ return s.on; });
    var ymax = 130, x0 = 2002.5, x1 = 2022.5;
    function X(v){ return m.l + (v - x0) / (x1 - x0) * (W - m.l - m.r); }
    function Y(v){ return H - m.b - v / ymax * (H - m.t - m.b); }
    svg = el('svg', {viewBox:'0 0 ' + W + ' ' + H, width:W, height:H, role:'img', 'aria-label':'Índices base 2003 igual a 100 para vítimas, taxa e população'}, null);
    wrap.insertBefore(svg, wrap.firstChild);
    [0, 25, 50, 75, 100, 125].forEach(function(t){
      el('line', {x1:m.l, x2:W - m.r, y1:Y(t), y2:Y(t), 'class': t === 0 ? 'base' : (t === 100 ? 'base' : 'grid')}, svg);
      el('text', {x:m.l - 8, y:Y(t) + 4, 'text-anchor':'end'}, svg).textContent = t;
    });
    var step = narrow ? 4 : 2;
    R.forEach(function(r){ if ((r.ano - 2003) % step === 0) el('text', {x:X(r.ano), y:H - m.b + 18, 'text-anchor':'middle'}, svg).textContent = r.ano; });
    el('text', {x:m.l, y:H - 4, 'class':'axis-title'}, svg).textContent = 'Índice (2003 = 100)';
    vis.forEach(function(s){
      el('path', {d:R.map(function(r, k){ return (k ? 'L' : 'M') + X(r.ano).toFixed(1) + ',' + Y(r[s.k]).toFixed(1); }).join(''), 'class':'ln ' + s.cls}, svg);
    });
    if (!narrow){ // rótulos diretos, com afastamento mínimo entre eles
      var labs = vis.map(function(s){ return {s:s, y:Y(R[R.length-1][s.k])}; }).sort(function(a, b){ return a.y - b.y; });
      for (var i = 1; i < labs.length; i++) if (labs[i].y - labs[i-1].y < 15) labs[i].y = labs[i-1].y + 15;
      labs.forEach(function(l){
        el('text', {x:X(2022) + 10, y:l.y + 4}, svg).textContent = l.s.nome.replace(' por 100 mil hab.', '/100 mil') + ' (' + fmt(R[R.length-1][l.s.k], 0) + ')';
      });
    }
    var cross = el('line', {y1:m.t, y2:H - m.b, 'class':'cross', visibility:'hidden'}, svg);
    var dots = vis.map(function(s){ return el('circle', {r:5, 'class':'pt ' + s.cls, visibility:'hidden'}, svg); });
    var hit = el('rect', {x:m.l, y:m.t, width:W - m.l - m.r, height:H - m.t - m.b, 'class':'hit', tabindex:0, role:'img', 'aria-label':'Use as setas esquerda e direita para percorrer os anos'}, svg);
    var cur = R.length - 1;
    function at(i){
      i = Math.max(0, Math.min(R.length - 1, i)); cur = i;
      var r = R[i], cx = X(r.ano);
      cross.setAttribute('x1', cx); cross.setAttribute('x2', cx); cross.setAttribute('visibility', 'visible');
      var html = '<b>' + r.ano + '</b>';
      vis.forEach(function(s, k){
        dots[k].setAttribute('cx', cx); dots[k].setAttribute('cy', Y(r[s.k])); dots[k].setAttribute('visibility', 'visible');
        html += '<br>' + s.nome + ': <b>' + fmt(r[s.k], 1) + '</b>';
      });
      tip.show(html, cx, m.t + 30);
    }
    function off(){ cross.setAttribute('visibility', 'hidden'); dots.forEach(function(d){ d.setAttribute('visibility', 'hidden'); }); tip.hide(); }
    function fromEvent(ev){
      var rc = svg.getBoundingClientRect(), px = (ev.clientX - rc.left) * (W / rc.width);
      return Math.round(x0 + (px - m.l) / (W - m.l - m.r) * (x1 - x0) - 2003);
    }
    hit.addEventListener('pointermove', function(ev){ at(fromEvent(ev)); });
    hit.addEventListener('pointerdown', function(ev){ at(fromEvent(ev)); });
    hit.addEventListener('pointerleave', off);
    hit.addEventListener('blur', off);
    hit.addEventListener('focus', function(){ at(cur); });
    hit.addEventListener('keydown', function(ev){
      if (ev.key === 'ArrowLeft'){ ev.preventDefault(); at(cur - 1); }
      if (ev.key === 'ArrowRight'){ ev.preventDefault(); at(cur + 1); }
    });
  }
  var go = setup(wrap, draw);
})();

/* ---------------- Figura 5: variações ---------------- */
(function(){
  var wrap = $('chartC'); if (!wrap) return;
  var only = false, tip = Tip(wrap), svg;
  var V = R.filter(function(r){ return r.var_pct !== null; });
  function draw(W){
    if (svg) wrap.removeChild(svg);
    var narrow = W < 520, H = Math.round(Math.max(270, Math.min(W * 0.55, 400)));
    var m = {l: narrow ? 40 : 52, r: 12, t: 14, b: 44};
    var data = V.filter(function(r){ return !only || r.acima_ruido; });
    var ymin = -60, ymax = 70;
    function Y(v){ return m.t + (ymax - v) / (ymax - ymin) * (H - m.t - m.b); }
    var n = data.length, slot = (W - m.l - m.r) / n, bw = Math.min(slot * 0.68, 34);
    function X(i){ return m.l + slot * (i + 0.5); }
    svg = el('svg', {viewBox:'0 0 ' + W + ' ' + H, width:W, height:H, role:'img', 'aria-label':'Variação percentual anual do total de vítimas'}, null);
    wrap.insertBefore(svg, wrap.firstChild);
    [-60, -40, -20, 0, 20, 40, 60].forEach(function(t){
      el('line', {x1:m.l, x2:W - m.r, y1:Y(t), y2:Y(t), 'class': t === 0 ? 'base' : 'grid'}, svg);
      el('text', {x:m.l - 8, y:Y(t) + 4, 'text-anchor':'end'}, svg).textContent = (t > 0 ? '+' : '') + String(t).replace('-', '−') + '%';
    });
    var every = narrow ? 2 : 1;
    data.forEach(function(r, i){ if (i % every === 0) el('text', {x:X(i), y:H - m.b + 18, 'text-anchor':'middle'}, svg).textContent = narrow ? String(r.ano).slice(2) : r.ano; });
    el('text', {x:m.l, y:H - 4, 'class':'axis-title'}, svg).textContent = 'Variação em relação ao mesmo quadrimestre do ano anterior';
    data.forEach(function(r, i){
      var y0 = Y(0), y1 = Y(r.var_pct), top = Math.min(y0, y1), h = Math.max(Math.abs(y1 - y0), 1);
      var b = el('rect', {x:X(i) - bw / 2, y:top, width:bw, height:h, rx:3, 'class':'bar' + (r.acima_ruido ? ' sig' : ''), tabindex:0, role:'img',
        'aria-label': r.ano + ': ' + sgn(r.var_pct, 1) + '%, ' + (r.acima_ruido ? 'acima do ruído de Poisson' : 'compatível com o acaso')}, svg);
      function on(){
        tip.show('<b>' + r.ano + '</b>: ' + sgn(r.var_pct, 1) + '%<br><span class="dim">z de Poisson:</span> ' + sgn(r.z_poisson, 2) +
          '<br><span class="dim">p (Bonferroni):</span> ' + (r.p_bonf < 0.001 ? '< 0,001' : fmt(r.p_bonf, 3)) +
          '<br>' + (r.acima_ruido ? '<b>acima do ruído</b>' : 'compatível com o acaso'), X(i), top);
      }
      var hit = el('rect', {x:X(i) - slot / 2, y:m.t, width:slot, height:H - m.t - m.b, 'class':'hit'}, svg);
      hit.addEventListener('pointerenter', on); hit.addEventListener('pointermove', on); hit.addEventListener('pointerleave', function(){ tip.hide(); });
      b.addEventListener('focus', on); b.addEventListener('blur', function(){ tip.hide(); });
      if (r.acima_ruido) el('text', {x:X(i), y: r.var_pct >= 0 ? y1 - 5 : y1 + 14, 'text-anchor':'middle', 'class':'halo', 'style':'font-weight:600'}, svg).textContent = sgn(r.var_pct, 0) + '%';
    });
  }
  var go = setup(wrap, draw);
  $('cOnly').addEventListener('change', function(e){ only = e.target.checked; go(); });
})();

/* ---------------- copiar código ---------------- */
Array.prototype.forEach.call(document.querySelectorAll('.copy'), function(btn){
  btn.addEventListener('click', function(){
    var code = btn.parentNode.querySelector('code').textContent, old = btn.textContent;
    function ok(){ btn.textContent = 'Copiado'; setTimeout(function(){ btn.textContent = old; }, 1400); }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(ok, function(){});
    else { var ta = document.createElement('textarea'); ta.value = code; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); ok(); } catch(e){} document.body.removeChild(ta); }
  });
});
})();
</script>
</body>
</html>
